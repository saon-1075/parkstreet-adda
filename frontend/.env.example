# Copy this file to `.env` and fill in from your Supabase project settings
# (Project Settings → API). These are the ONLY secrets — everything
# brand-specific lives in src/config/restaurant.config.ts instead.
#
# The app runs on mock data until BOTH are set (see hasSupabase in src/data/menu.ts).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — enables the "Pay online" (Razorpay) button. Use your TEST key_id
# (rzp_test_...). This is the publishable key and is safe in the browser; never
# put the Razorpay key SECRET here. Leave blank to keep WhatsApp-only checkout.
VITE_RAZORPAY_KEY_ID=
